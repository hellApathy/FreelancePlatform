@model FreelancePlatform.Web.Models.OrderViewModel

@{
    ViewData["Title"] = "Створити замовлення";
}

<h2>Створити нове замовлення</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <!-- Виводить загальний список помилок форми -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label fw-bold"></label>
                <input asp-for="Title" class="form-control" placeholder="Наприклад: Розробка дизайну" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label fw-bold"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Budget" class="control-label fw-bold"></label>
                <input asp-for="Budget" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Budget" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Створити</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Повернутися до списку</a>
            </div>
        </form>
    </div>
</div>

<!-- Підключення скриптів для Client-Side валідації без перезавантаження сторінки -->
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}