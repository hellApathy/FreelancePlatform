@model IEnumerable<FreelancePlatform.Domain.Entities.Order>

@{
    ViewData["Title"] = "Дошка замовлень";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Доступні замовлення для фрілансерів</h2>
    <p class="text-muted">Знайдіть ідеальний проект для себе з нашого списку актуальних замовлень.</p>
    <a asp-action="Create" class="btn btn-success mb-3">
    + Додати нове замовлення
</a>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Назва проєкту</th>
                        <th>Опис завдання</th>
                        <th>Бюджет ($)</th>
                        <th>Дія</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>#@item.Id</strong></td>
                            <td>@item.Title</td>
                            <td>@item.Description</td>
                            <td class="text-success fw-bold">@item.Budget</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary">Відгукнутися</button>
                            </td>
                            <td>
                                 <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a>
                          </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>